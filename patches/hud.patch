diff --git a/codex-rs/tui/src/chatwidget/status_command_input.rs b/codex-rs/tui/src/chatwidget/status_command_input.rs
new file mode 100644
index 0000000..5fb3d81
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/status_command_input.rs
@@ -0,0 +1,104 @@
+//! Builds the JSON snapshot that `tui.status_line_command` receives on stdin.
+//!
+//! Field names follow Claude Code's statusLine payload where an equivalent exists
+//! (`model`, `effort`, `context_window`, `rate_limits`) so existing HUD scripts port easily;
+//! Codex-only extras live under `codex`.
+
+use super::*;
+use serde_json::json;
+
+const SHORT_WINDOW_MAX_MINUTES: i64 = 24 * 60;
+
+impl ChatWidget {
+    pub(super) fn publish_status_line_command_input(&self) {
+        let Some(command) = self.status_line_command.as_ref() else {
+            return;
+        };
+        let cwd = self
+            .current_cwd
+            .as_deref()
+            .unwrap_or(self.config.cwd.as_path())
+            .display()
+            .to_string();
+        let context_window_size = self.status_line_context_window_size();
+        let last_usage = self.token_info.as_ref().map(|info| &info.last_token_usage);
+        let total_usage = self.token_info.as_ref().map(|info| &info.total_token_usage);
+        let used_percentage = match (last_usage, context_window_size) {
+            (Some(usage), Some(size)) if size > 0 => {
+                Some((usage.total_tokens as f64 / size as f64 * 100.0).clamp(0.0, 100.0))
+            }
+            _ => None,
+        };
+        command.set_input(json!({
+            "hook_event_name": "Status",
+            "session_id": self.thread_id.map(|id| id.to_string()),
+            "transcript_path": self
+                .current_rollout_path
+                .as_ref()
+                .map(|path| path.display().to_string()),
+            "cwd": cwd,
+            "workspace": { "current_dir": cwd },
+            "version": CODEX_CLI_VERSION,
+            "model": {
+                "id": self.current_model(),
+                "display_name": self.model_display_name(),
+            },
+            "effort": {
+                "level": Self::status_line_reasoning_effort_label(
+                    self.effective_reasoning_effort().as_ref(),
+                ),
+            },
+            "context_window": {
+                "context_window_size": context_window_size,
+                "used_percentage": used_percentage,
+                "codex_used_percentage": self.status_line_context_used_percent(),
+                "current_usage": last_usage.map(|usage| json!({
+                    "input_tokens": usage.input_tokens,
+                    "cached_input_tokens": usage.cached_input_tokens,
+                    "output_tokens": usage.output_tokens,
+                    "reasoning_output_tokens": usage.reasoning_output_tokens,
+                    "total_tokens": usage.total_tokens,
+                })),
+                "total_input_tokens": total_usage.map(|usage| usage.input_tokens),
+                "total_output_tokens": total_usage.map(|usage| usage.output_tokens),
+            },
+            "codex": {
+                "plan_type": self.plan_type,
+                "run_state": self.run_state_status_text(),
+                "thread_name": self.thread_name.as_deref(),
+            },
+        }));
+    }
+
+    /// Maps the Codex limit windows onto Claude-style `five_hour` / `seven_day` keys.
+    pub(super) fn publish_status_line_command_rate_limits(&self, snapshot: &RateLimitSnapshot) {
+        let Some(command) = self.status_line_command.as_ref() else {
+            return;
+        };
+        let mut limits = serde_json::Map::new();
+        for (window, fallback_key) in [
+            (snapshot.primary.as_ref(), "five_hour"),
+            (snapshot.secondary.as_ref(), "seven_day"),
+        ] {
+            let Some(window) = window else {
+                continue;
+            };
+            let key = match window.window_duration_mins {
+                Some(minutes) if minutes <= SHORT_WINDOW_MAX_MINUTES => "five_hour",
+                Some(_) => "seven_day",
+                None => fallback_key,
+            };
+            limits.entry(key).or_insert_with(|| {
+                json!({
+                    "used_percentage": window.used_percent,
+                    "resets_at": window.resets_at,
+                    "window_minutes": window.window_duration_mins,
+                })
+            });
+        }
+        if let Some(plan_type) = self.plan_type {
+            limits.insert("plan_type".to_string(), json!(plan_type));
+        }
+        command.set_rate_limits(limits);
+    }
+}
