diff --git a/codex-rs/tui/src/status_line_command.rs b/codex-rs/tui/src/status_line_command.rs
new file mode 100644
index 0000000..3cc0912
--- /dev/null
+++ b/codex-rs/tui/src/status_line_command.rs
@@ -0,0 +1,221 @@
+//! Command-backed status HUD rendered below the composer (`tui.status_line_command`).
+//!
+//! Mirrors Claude Code's `statusLine` command: the configured shell command receives a JSON
+//! snapshot of the session on stdin and its stdout (multiple ANSI-colored lines allowed) is
+//! rendered verbatim under the composer. The command re-runs about once per second, and shortly
+//! after the session snapshot changes, on a background task so rendering never blocks on it.
+
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::Weak;
+use std::time::Duration;
+
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::text::Line;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use serde_json::Value;
+use tokio::io::AsyncWriteExt;
+use tokio::sync::Notify;
+
+use crate::bottom_pane::inset_footer_hint_area;
+use crate::render::renderable::Renderable;
+use crate::tui::FrameRequester;
+
+const REFRESH_INTERVAL: Duration = Duration::from_millis(1000);
+const INPUT_DEBOUNCE: Duration = Duration::from_millis(150);
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(5);
+const MAX_LINES: usize = 10;
+
+#[derive(Default)]
+struct State {
+    input: Option<Value>,
+    rate_limits: Option<Value>,
+    lines: Vec<Line<'static>>,
+}
+
+struct Shared {
+    state: Mutex<State>,
+    notify: Arc<Notify>,
+}
+
+/// Handle to the background runner. Cloning shares the same runner; the runner stops once every
+/// handle has been dropped.
+#[derive(Clone)]
+pub(crate) struct StatusLineCommand {
+    shared: Arc<Shared>,
+}
+
+impl StatusLineCommand {
+    pub(crate) fn spawn(command: String, frame_requester: FrameRequester) -> Self {
+        let shared = Arc::new(Shared {
+            state: Mutex::new(State::default()),
+            notify: Arc::new(Notify::new()),
+        });
+        tokio::spawn(run_loop(command, Arc::downgrade(&shared), frame_requester));
+        Self { shared }
+    }
+
+    /// Replaces the session snapshot passed to the command; wakes the runner when it changed.
+    pub(crate) fn set_input(&self, input: Value) {
+        let mut state = self.lock();
+        if state.input.as_ref() != Some(&input) {
+            state.input = Some(input);
+            self.shared.notify.notify_one();
+        }
+    }
+
+    /// Merges limit windows into the last known set; rolling updates can be sparse, so a window
+    /// missing from one update keeps its previous value.
+    pub(crate) fn set_rate_limits(&self, rate_limits: serde_json::Map<String, Value>) {
+        let mut state = self.lock();
+        let mut merged = match state.rate_limits.clone() {
+            Some(Value::Object(map)) => map,
+            _ => serde_json::Map::new(),
+        };
+        merged.extend(rate_limits);
+        let merged = Value::Object(merged);
+        if state.rate_limits.as_ref() != Some(&merged) {
+            state.rate_limits = Some(merged);
+            self.shared.notify.notify_one();
+        }
+    }
+
+    pub(crate) fn hud(&self) -> Option<StatusLineHud> {
+        let lines = self.lock().lines.clone();
+        (!lines.is_empty()).then_some(StatusLineHud { lines })
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, State> {
+        self.shared
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+    }
+}
+
+/// The most recent command output, laid out with the footer's left inset.
+pub(crate) struct StatusLineHud {
+    lines: Vec<Line<'static>>,
+}
+
+impl Renderable for StatusLineHud {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        Paragraph::new(self.lines.clone()).render(inset_footer_hint_area(area), buf);
+    }
+
+    fn desired_height(&self, _width: u16) -> u16 {
+        u16::try_from(self.lines.len()).unwrap_or(u16::MAX)
+    }
+}
+
+async fn run_loop(command: String, shared: Weak<Shared>, frame_requester: FrameRequester) {
+    let Some(notify) = shared.upgrade().map(|shared| Arc::clone(&shared.notify)) else {
+        return;
+    };
+    let mut first_run = true;
+    loop {
+        if !first_run {
+            tokio::select! {
+                () = notify.notified() => tokio::time::sleep(INPUT_DEBOUNCE).await,
+                () = tokio::time::sleep(REFRESH_INTERVAL) => {}
+            }
+        }
+        first_run = false;
+
+        let Some((stdin_json, cwd)) = shared.upgrade().map(|shared| snapshot(&shared)) else {
+            return;
+        };
+        let lines = run_command(&command, cwd, stdin_json)
+            .await
+            .map(|stdout| parse_lines(&stdout));
+        let Some(shared) = shared.upgrade() else {
+            return;
+        };
+        if let Some(lines) = lines {
+            let mut state = shared
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if state.lines != lines {
+                state.lines = lines;
+                frame_requester.schedule_frame();
+            }
+        }
+    }
+}
+
+fn snapshot(shared: &Shared) -> (String, Option<PathBuf>) {
+    let state = shared
+        .state
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut payload = match state.input.clone() {
+        Some(Value::Object(map)) => map,
+        _ => serde_json::Map::new(),
+    };
+    if let Some(rate_limits) = state.rate_limits.clone() {
+        payload.insert("rate_limits".to_string(), rate_limits);
+    }
+    let cwd = payload
+        .get("cwd")
+        .and_then(Value::as_str)
+        .map(PathBuf::from)
+        .filter(|cwd| cwd.is_dir());
+    (Value::Object(payload).to_string(), cwd)
+}
+
+fn parse_lines(stdout: &str) -> Vec<Line<'static>> {
+    stdout
+        .trim_end_matches(['\r', '\n'])
+        .lines()
+        .take(MAX_LINES)
+        .map(|line| codex_ansi_escape::ansi_escape_line(line.trim_end_matches('\r')))
+        .collect()
+}
+
+async fn run_command(command: &str, cwd: Option<PathBuf>, stdin_json: String) -> Option<String> {
+    let mut cmd = shell_command(command);
+    if let Some(cwd) = cwd {
+        cmd.current_dir(cwd);
+    }
+    cmd.stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true);
+    let mut child = cmd.spawn().ok()?;
+    if let Some(mut stdin) = child.stdin.take() {
+        // A command that ignores stdin may exit before reading it; that is fine.
+        let _ = stdin.write_all(stdin_json.as_bytes()).await;
+    }
+    let output = tokio::time::timeout(COMMAND_TIMEOUT, child.wait_with_output())
+        .await
+        .ok()?
+        .ok()?;
+    output
+        .status
+        .success()
+        .then(|| String::from_utf8_lossy(&output.stdout).into_owned())
+}
+
+#[cfg(windows)]
+fn shell_command(command: &str) -> tokio::process::Command {
+    use std::os::windows::process::CommandExt;
+    // Keep the child off Codex's console so it cannot touch the TUI's console modes.
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    let mut cmd = std::process::Command::new("cmd");
+    cmd.args(["/D", "/S", "/C"])
+        .raw_arg(format!("\"{command}\""))
+        .creation_flags(CREATE_NO_WINDOW);
+    tokio::process::Command::from(cmd)
+}
+
+#[cfg(not(windows))]
+fn shell_command(command: &str) -> tokio::process::Command {
+    let mut cmd = tokio::process::Command::new("sh");
+    cmd.arg("-c").arg(command);
+    cmd
+}
